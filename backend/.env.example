# Backend Environment Variables Template
DEBUG=True
SECRET_KEY=change-this-to-a-unique-secret-key-for-production

# Production Database (PostgreSQL / MySQL / SQLite)
# Example PostgreSQL: postgres://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

